# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL / Redis
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# AI provider:
#   mock   - no AI, credential-free development and tests
#   local  - self-hosted models via Ollama/vLLM (start with `docker compose --profile local-ai up`)
#   openai - OpenAI API (document text is sent to OpenAI)
AI_PROVIDER=mock
# Leave empty to use 1024 for `local` (bge-m3) and 1536 otherwise. The database vector column is
# created with this size on first migrate, so switching provider needs `docker compose down -v`.
EMBEDDING_DIMENSIONS=

# Self-hosted models. bge-m3 is multilingual with strong Persian support; qwen2.5 answers well in
# Persian. Use a larger chat model (e.g. qwen2.5:14b) if the server has the memory for it.
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_CHAT_MODEL=qwen2.5:7b

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1


# Billing. Prices are in Toman; the defaults are placeholders, set your own.
BILLING_TRIAL_DAYS=14
PRICE_PRO_MONTHLY_TOMAN=3000000
PRICE_PRO_YEARLY_TOMAN=30000000
# `dev` simulates payments locally (nothing is charged); `zarinpal` uses the real gateway.
BILLING_GATEWAY=dev
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
BILLING_CALLBACK_URL=http://localhost:8000/api/v1/billing/callback/
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SALES_EMAIL=

# Self-hosted license (set by the vendor for on-premises customers; see README).
DOCUMIND_LICENSE=
DOCUMIND_LICENSE_PUBLIC_KEY=
