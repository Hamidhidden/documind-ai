FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# NEXT_PUBLIC_* values are compiled into the browser bundle, so they must be set at build time.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_SALES_EMAIL=
ARG NEXT_PUBLIC_COMPANY_NAME=
ARG NEXT_PUBLIC_COMPANY_ADDRESS=
ARG NEXT_PUBLIC_COMPANY_PHONE=
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ARG NEXT_PUBLIC_ENAMAD_ID=
ARG NEXT_PUBLIC_ENAMAD_CODE=
ARG NEXT_PUBLIC_LEGAL_REVIEWED=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SALES_EMAIL=$NEXT_PUBLIC_SALES_EMAIL \
    NEXT_PUBLIC_COMPANY_NAME=$NEXT_PUBLIC_COMPANY_NAME \
    NEXT_PUBLIC_COMPANY_ADDRESS=$NEXT_PUBLIC_COMPANY_ADDRESS \
    NEXT_PUBLIC_COMPANY_PHONE=$NEXT_PUBLIC_COMPANY_PHONE \
    NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL \
    NEXT_PUBLIC_ENAMAD_ID=$NEXT_PUBLIC_ENAMAD_ID \
    NEXT_PUBLIC_ENAMAD_CODE=$NEXT_PUBLIC_ENAMAD_CODE \
    NEXT_PUBLIC_LEGAL_REVIEWED=$NEXT_PUBLIC_LEGAL_REVIEWED
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
